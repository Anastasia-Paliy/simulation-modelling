							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[x1 += sign_x1 * step;
y1 += sign_y1 * step;
if (x1 == 200 - a/2 && y1 == 800 - a/2) {
	sign_x1 = 1;
	sign_y1 = 0;
} else if ((x1 == 800 - a/2) && (y1 == 800 - a/2)) {
	sign_x1 = 0;
	sign_y1 = 1;
} else if (x1 == 800 - a/2 && y1 == 1200 - a/2) {
	sign_x1 = -1;
	sign_y1 = 0;
} else if (x1 == 200 - a/2 && y1 == 1200 - a/2) {
	sign_x1 = 0;
	sign_y1 = -1;
} else ;
]]></Action>
				</Event>
