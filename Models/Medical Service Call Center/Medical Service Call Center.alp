								<Code><![CDATA[if (agent instanceof RegistrationCall) {
    RegistrationCall a = (RegistrationCall) agent;
    a.enter_queue_time = time();
    } else {
    ConsultationCall a = (ConsultationCall) agent;
    a.enter_queue_time = time();
