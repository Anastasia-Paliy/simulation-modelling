			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[RectangularNode]]></ReturnType>
					<Id>1773760704773</Id>
					<Name><![CDATA[getNearestStair]]></Name>
					<X>-1375.47</X><Y>-929.227</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Passenger]]></Type>
					</Parameter>
					<Body><![CDATA[// Если коллекция пуста, возвращаем null
if (GostinyStairs.isEmpty()) {
    traceln("Ошибка: Коллекция лестниц пуста!");
    return null;
}

// Инициализируем переменные для поиска
double minDist = Double.MAX_VALUE;
RectangularNode nearestStair = null;
// Проходим по всем лестницам в коллекции
for (RectangularNode stair : GostinyStairs) {
    // Получаем координаты центра лестницы (или другой точки)
    // Внимание: distanceTo() учитывает препятствия? Нет, это евклидово расстояние.
    // Для более точного расчета см. Вариант 2.
    double dist = ped.distanceTo(stair.getCenter()); 
    
    if (dist < minDist) {
        minDist = dist;
        nearestStair = stair;
    }
}
return nearestStair;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1773766418005</Id>
					<Name><![CDATA[startTrainUnload]]></Name>
					<X>-1660</X><Y>-480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trainIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[setTrainUnloadRate(trainIndex, uniform_discr(5, 20));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1773766418007</Id>
					<Name><![CDATA[setTrainUnloadRate]]></Name>
					<X>-1660</X><Y>-424.859</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trainIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[rate]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[AgentList<PedSource<Passenger>> pedSources = null;
switch(trainIndex){
	case 0:{
		pedSources = PS_TrainDoorsKupchino;
		break;
	}
	case 1:{
		pedSources = PS_TrainDoorsParnas;
		break;
	}
	case 2:{
		pedSources = PS_TrainDoorsBegovaya;
		break;
	}
	case 3:{
		pedSources = PS_TrainDoorsRybatskoe;
		break;
	}
}
for(PedSource<Passenger> currentPedSource: pedSources){
	currentPedSource.set_rate(rate, PER_MINUTE);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1773766418009</Id>
					<Name><![CDATA[stopTrainUnload]]></Name>
					<X>-1660</X><Y>-452.429</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trainIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[setTrainUnloadRate(trainIndex, 0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1773766418011</Id>
					<Name><![CDATA[startTrainUpload]]></Name>
					<X>-1660</X><Y>-397.288</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trainIndex]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[List<GoToTrain> goToTrain = new ArrayList<>();

if (trainIndex == 0) {
    for (GoToTrain p : goToKupchino) goToTrain.add(p);
} else if (trainIndex == 1) {
    for (GoToTrain p : goToParnas) goToTrain.add(p);
} else if (trainIndex == 2) {
    for (GoToTrain p : goToBegovaya) goToTrain.add(p);
} else if (trainIndex == 3) {
    for (GoToTrain p : goToRybatskoe) goToTrain.add(p);
}

for (GoToTrain goTo : goToTrain) {
    goTo.board();
}]]></Body>
				</Function>
