				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1772694707064</Id>
					<Name><![CDATA[button]]></Name>
					<X>380</X><Y>40</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="100" Height="30">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor/>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[for (int i=1; i<=presentation.size(); i++) {
	Object figure = presentation.get(i-1);
	if (figure instanceof ShapeLine) {
		line = (ShapeLine) figure;
		excelFile1.setCellValue("Отрезок", 1, i, 1);
		excelFile1.setCellValue(line.getX(), 1, i, 2);
		excelFile1.setCellValue(line.getY(), 1, i, 3);
		excelFile1.setCellValue(line.getEndX(), 1, i, 4);
		excelFile1.setCellValue(line.getEndY(), 1, i, 5);
	} else if (figure instanceof ShapeRectangle) {
		rectangle = (ShapeRectangle) figure;
		excelFile1.setCellValue("Прямоугольник", 1, i, 1);
		excelFile1.setCellValue(rectangle.getX(), 1, i, 2);
		excelFile1.setCellValue(rectangle.getY(), 1, i, 3);
	} else if (figure instanceof ShapeOval) {
		oval = (ShapeOval) figure;
		excelFile1.setCellValue("Овал", 1, i, 1);
		excelFile1.setCellValue(oval.getX(), 1, i, 2);
		excelFile1.setCellValue(oval.getY(), 1, i, 3);
		excelFile1.setCellValue(oval.getRadiusX(), 1, i, 4);
		excelFile1.setCellValue(oval.getRadiusY(), 1, i, 5);
	} else {}
}
]]></ActionCode>
